#!/usr/bin/env python3
# osengineer — the osEngineer skill CLI (Python 3, no external dependencies).
#
# Subcommands:
#   init <path>                       Run install.sh on a repo or workbench
#   state                             Show current phase/team/budget
#   state set <k> <v>                 Update a state.yml field
#   detect-teams <path>               Auto-detect folder→team mapping
#                                     (Go modules → coding, ansible/ → infra,
#                                      *_test.go → testing, docs/ → docs,
#                                      .github/codeql or security/ → security).
#                                     Outputs YAML to stdout suitable for the
#                                     `teams:` block of a repo AGENTS.md.
#   handoff open --from <t> --to <t> --slug <s> [--closes-when "<text>"]
#                                     Open a cross-team handoff ticket.
#   handoff close <id> [--reason "<text>"]
#                                     Close an open handoff.
#   handoff list                      List open handoffs in cwd repo.
#   discover-adrs <meta-path> [--out <file>]
#                                     Scan a META repo for ADRs; emit YAML catalog
#   evolve [status]                   Show counter + open/closed proposals
#   evolve propose --title "<t>" [--body "<text>" | --body-file <f>] [--category <c>]
#   evolve accept <id> --pattern-slug <s> [--pattern-file <f>]
#                                     Promote proposal to memory/patterns/<s>.md; reset counter
#   evolve reject <id> --reason "<text>"
#                                     Log rejection; reset counter
#   scaffold agent <name> [--role <r>] [--scope <s>] [--escalates-to <list>]
#                                     Materialise a new agent file from template
#   scaffold command <name> [--phase-allowed <list>] [--phase-after <p>]
#                                     Materialise a new command file from template
#   version                           Print osEngineer version
#   explain [topic]                   overview|phases|hooks|teams|handoffs|scaffold

import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path
from subprocess import run

SCRIPT_DIR = Path(__file__).resolve().parent.parent
VERSION_FILE = SCRIPT_DIR / "VERSION"
VERSION = VERSION_FILE.read_text().strip() if VERSION_FILE.exists() else "0.0.0-dev"


# ── Helpers ──────────────────────────────────────────────────────────────────

def find_repo_root(cwd=None):
    current = Path(cwd or os.getcwd()).resolve()
    for _ in range(8):
        if (current / ".git").is_dir():
            return current
        parent = current.parent
        if parent == current:
            break
        current = parent
    return None


def find_osengineer_root(cwd=None):
    current = Path(cwd or os.getcwd()).resolve()
    for _ in range(8):
        if (current / ".osengineer").is_dir():
            is_repo = (current / ".git").is_dir()
            return current, "repo" if is_repo else "workbench"
        parent = current.parent
        if parent == current:
            break
        current = parent
    return None, None


def read_workbench_config(workbench_root):
    p = Path(workbench_root) / ".osengineer" / "workbench-config.yml"
    if not p.exists():
        return None
    config = {}
    current_array = None
    for raw in p.read_text().splitlines():
        line = raw.rstrip()
        if not line.strip() or line.strip().startswith("#"):
            continue
        top_key = re.match(r"^(\w+):\s*(.*)$", line)
        if top_key and not line.startswith(" ") and not line.startswith("-"):
            key, val = top_key.group(1), top_key.group(2).strip()
            val = val.strip("\"'")
            if val == "":
                config[key] = []
                current_array = config[key]
            else:
                config[key] = val
                current_array = None
            continue
        array_item = re.match(r"^\s+- (\w+):\s*(.*)$", line)
        if array_item and current_array is not None:
            key, val = array_item.group(1), array_item.group(2).strip().strip("\"'")
            current_array.append({key: val})
            continue
        nested_key = re.match(r"^\s+(\w+):\s*(.*)$", line)
        if nested_key and current_array and current_array and isinstance(current_array[-1], dict):
            current_array[-1][nested_key.group(1)] = nested_key.group(2).strip().strip("\"'")
    for k in list(config.keys()):
        if isinstance(config[k], list) and len(config[k]) == 0:
            del config[k]
    return config


def read_state_map(repo_root):
    p = Path(repo_root) / ".osengineer" / "state.yml"
    if not p.exists():
        return None
    state = {}
    for line in p.read_text().splitlines():
        m = re.match(r"^(\w+):\s*(.*)$", line)
        if not m:
            continue
        val = m.group(2).strip().strip("\"'")
        state[m.group(1)] = val or None
    return state


def write_state_field(repo_root, key, value):
    p = Path(repo_root) / ".osengineer" / "state.yml"
    p.parent.mkdir(parents=True, exist_ok=True)
    if not p.exists():
        p.write_text(f"{key}: {value}\n")
        return
    lines = p.read_text().splitlines()
    found = False
    for i, line in enumerate(lines):
        if re.match(r"^" + re.escape(key) + r":", line):
            lines[i] = f"{key}: {value}"
            found = True
            break
    if not found:
        lines.append(f"{key}: {value}")
    p.write_text("\n".join(lines) + "\n")


def list_dir_safe(d):
    try:
        return sorted(os.listdir(d))
    except Exception:
        return []


def has_any(repo, *patterns):
    return any((Path(repo) / p).exists() for p in patterns)


def has_dir(repo, *patterns):
    return any((Path(repo) / p).is_dir() for p in patterns)


def has_file_matching(repo, regex, depth=3):
    pattern = re.compile(regex)
    stack = [(Path(repo), 0)]
    while stack:
        d, ddepth = stack.pop()
        if ddepth > depth:
            continue
        try:
            for name in list_dir_safe(d):
                if name in {".git", "node_modules", "vendor", "graphify-out", ".osengineer"}:
                    continue
                full = d / name
                try:
                    if full.is_dir():
                        stack.append((full, ddepth + 1))
                    elif pattern.search(name):
                        return True
                except Exception:
                    continue
        except Exception:
            continue
    return False


# ── Subcommands ───────────────────────────────────────────────────────────────

def cmd_version():
    print(f"osengineer {VERSION}")


def cmd_state(args):
    repo_root = find_repo_root()
    if args and args[0] == "set":
        if not repo_root:
            print("osengineer: not inside a git repo", file=sys.stderr)
            sys.exit(1)
        if len(args) < 3:
            print("Usage: osengineer state set <key> <value>", file=sys.stderr)
            sys.exit(1)
        key = args[1]
        value = " ".join(args[2:])
        write_state_field(repo_root, key, value)
        print(f"set {key} = {value}")
        return
    if not repo_root:
        print("osengineer: not inside a git repo", file=sys.stderr)
        sys.exit(1)
    state = read_state_map(repo_root)
    if not state:
        print("No .osengineer/ directory. Run install.sh first.")
        sys.exit(0)
    for k, v in state.items():
        print(f"{k}: {v}")


def cmd_init(args):
    target = Path(args[0]).resolve() if args else Path.cwd()
    if not target.exists():
        print(f"osengineer: {target} does not exist", file=sys.stderr)
        sys.exit(1)
    install_script = SCRIPT_DIR / "install.sh"
    if not install_script.exists():
        print(f"osengineer: install.sh not found at {install_script}", file=sys.stderr)
        sys.exit(1)
    is_repo = (target / ".git").is_dir()
    install_args = [str(install_script), str(target)] if is_repo else [str(install_script), "--workbench", str(target)]
    result = run(["bash"] + install_args)
    sys.exit(result.returncode if result.returncode is not None else 1)


def detect_teams(repo):
    teams = []
    has_go = has_any(repo, "go.mod")
    has_python = has_any(repo, "pyproject.toml", "setup.py", "requirements.txt")
    has_node = has_any(repo, "package.json")
    has_rust = has_any(repo, "Cargo.toml")
    has_ansible = has_dir(repo, "ansible", "roles", "playbooks")
    has_compose = has_file_matching(repo, r"^docker-compose.*\.ya?ml$")
    has_src_dir = has_dir(repo, "src", "internal", "cmd", "pkg")
    has_tests_dir = has_dir(repo, "test", "tests", "integration", "e2e")
    has_go_tests = has_file_matching(repo, r"^.+_test\.go$")
    has_py_tests = has_file_matching(repo, r"^test_.+\.py$")
    has_docs = has_dir(repo, "docs") or has_any(repo, "README.md", "README.rst")
    has_contracts = has_dir(repo, "contracts") or has_file_matching(repo, r"^.+\.openapi\.ya?ml$")
    has_codeql = has_dir(repo, ".github/codeql")
    has_security_dir = has_dir(repo, "security")

    coding_paths = []
    if has_go:
        coding_paths.extend(["internal/**", "cmd/**", "pkg/**"])
    if has_python or has_node or has_rust:
        coding_paths.append("src/**")
    if has_src_dir and not coding_paths:
        coding_paths.append("src/**")
    if coding_paths:
        folder = "internal/" if has_go and has_dir(repo, "internal") else ("src/" if has_dir(repo, "src") else None)
        teams.append({
            "team_id": "coding",
            "folder": folder,
            "agents": ["developer", "reviewer"],
            "owns_paths": coding_paths,
            "reads_paths": ["api/**", "contracts/**", "ansible/**", "docs/**"],
            "escalates_to": ["testing", "infra", "docs", "security"],
        })

    testing_paths = []
    if has_go_tests:
        testing_paths.append("**/*_test.go")
    if has_py_tests:
        testing_paths.append("**/test_*.py")
    if has_tests_dir:
        testing_paths.extend(["tests/**", "test/**", "integration/**", "e2e/**"])
    if testing_paths:
        folder = None
        if has_tests_dir:
            folder = "tests/" if (Path(repo) / "tests").is_dir() else "test/"
        teams.append({
            "team_id": "testing",
            "folder": folder,
            "agents": ["qa"],
            "owns_paths": testing_paths,
            "reads_paths": ["internal/**", "cmd/**", "pkg/**", "src/**", "api/**", "contracts/**"],
            "escalates_to": ["coding"],
        })

    infra_paths = []
    if has_ansible:
        infra_paths.extend(["ansible/**", "roles/**", "playbooks/**"])
    if has_compose:
        infra_paths.extend(["docker-compose*.yml", "Dockerfile*"])
    if has_dir(repo, "scripts"):
        infra_paths.append("scripts/**")
    if has_dir(repo, ".github/workflows"):
        infra_paths.append(".github/workflows/**")
    if infra_paths:
        teams.append({
            "team_id": "infra",
            "folder": "ansible/" if has_ansible else None,
            "agents": ["topology-validator", "live-system-operator", "cert-monitor", "health-verifier"],
            "owns_paths": infra_paths,
            "reads_paths": ["**/*.yml", "**/Dockerfile", "service-manifest.yml", "contracts/**"],
            "escalates_to": ["coding", "security", "docs"],
        })

    docs_paths = []
    if has_docs:
        docs_paths.extend(["docs/**", "README*.md"])
    if has_contracts:
        docs_paths.extend(["contracts/**", "**/*.openapi.yaml", "**/*.openapi.yml"])
    docs_paths.extend(["**/*.schema.json", "service-manifest.yml", "message-contract*.yaml"])
    teams.append({
        "team_id": "docs",
        "folder": "docs/" if has_dir(repo, "docs") else None,
        "agents": ["tech-writer"],
        "owns_paths": docs_paths,
        "reads_paths": ["**"],
        "escalates_to": ["coding", "infra", "security"],
    })

    security_paths = [".github/codeql/**", "security/**", ".secretscanignore", ".base64scanignore"]
    teams.append({
        "team_id": "security",
        "folder": ".github/codeql/" if has_codeql else ("security/" if has_security_dir else None),
        "agents": ["red-team-local", "red-team-architect"],
        "owns_paths": security_paths,
        "reads_paths": ["**"],
        "escalates_to": ["coding", "infra", "docs"],
    })

    return teams


def teams_to_yaml_block(teams, indent="  "):
    lines = []
    for t in teams:
        folder = t["folder"] if t["folder"] is not None else "null"
        lines.append(f"{indent}- team_id: {t['team_id']}")
        lines.append(f"{indent}  folder: {folder}")
        lines.append(f"{indent}  agents: [{', '.join(t['agents'])}]")
        lines.append(f"{indent}  owns_paths:")
        for p in t["owns_paths"]:
            lines.append(f'{indent}    - "{p}"')
        lines.append(f"{indent}  reads_paths:")
        for p in t["reads_paths"]:
            lines.append(f'{indent}    - "{p}"')
        lines.append(f"{indent}  escalates_to: [{', '.join(t['escalates_to'])}]")
    return "\n".join(lines)


def cmd_detect_teams(args):
    target = Path(args[0]).resolve() if args else Path.cwd()
    if not target.exists():
        print(f"osengineer: {target} does not exist", file=sys.stderr)
        sys.exit(1)
    teams = detect_teams(target)
    print(teams_to_yaml_block(teams))
    cache_dir = Path(target) / ".osengineer" / "teams"
    if cache_dir.parent.is_dir():
        cache_dir.mkdir(parents=True, exist_ok=True)
        for t in teams:
            (cache_dir / f"{t['team_id']}.json").write_text(json.dumps(t, indent=2) + "\n")


def parse_flags(args, allowed):
    out = {}
    i = 0
    while i < len(args):
        a = args[i]
        if not a.startswith("--"):
            i += 1
            continue
        eq = a.find("=")
        key = a[2:eq] if eq != -1 else a[2:]
        if key not in allowed:
            i += 1
            continue
        if eq != -1:
            out[key] = a[eq + 1:]
        elif i + 1 < len(args) and not args[i + 1].startswith("--"):
            i += 1
            out[key] = args[i]
        else:
            out[key] = ""
        i += 1
    return out


def update_frontmatter(content, updates):
    lines = content.splitlines()
    start_idx = -1
    end_idx = -1
    for i, line in enumerate(lines):
        if line.strip() == "---":
            if start_idx == -1:
                start_idx = i
            else:
                end_idx = i
                break
    if start_idx == -1 or end_idx == -1:
        return content
    fm_lines = lines[start_idx + 1:end_idx]
    for key, value in updates.items():
        key_re = re.compile(r"^" + re.escape(key) + r":\s*")
        idx = next((i for i, l in enumerate(fm_lines) if key_re.match(l)), -1)
        if idx != -1:
            fm_lines[idx] = f"{key}: {value}"
        else:
            fm_lines.append(f"{key}: {value}")
    return "\n".join(lines[:start_idx + 1] + fm_lines + lines[end_idx:])


def cmd_handoff(args):
    ose = find_osengineer_root()
    if not ose[0]:
        print("osengineer: cwd is not inside an osEngineer-initialised workbench or repo", file=sys.stderr)
        sys.exit(1)
    root, scope = ose
    flags = parse_flags(args, ["scope"])
    scope = flags.get("scope", scope)
    if scope not in {"workbench", "repo"}:
        print(f'osengineer: invalid --scope "{scope}" (must be workbench or repo)', file=sys.stderr)
        sys.exit(1)
    prefix = "XR" if scope == "workbench" else "HO"
    handoffs_dir = Path(root) / ".osengineer" / "handoffs"
    handoffs_dir.mkdir(parents=True, exist_ok=True)

    clean_args = []
    i = 0
    while i < len(args):
        if args[i] == "--scope":
            i += 2
            continue
        clean_args.append(args[i])
        i += 1

    sub = clean_args[0] if clean_args else ""

    if sub == "open":
        allowed = ["from", "to", "slug", "closes-when", "from-repo", "to-repo"]
        flags = parse_flags(clean_args[1:], allowed)
        if not flags.get("slug"):
            print('Usage: osengineer handoff open --slug <s> [--from <team>] [--to <team>] [--from-repo <r>] [--to-repo <r>] [--closes-when "<text>"]', file=sys.stderr)
            sys.exit(1)
        if scope == "repo" and (not flags.get("from") or not flags.get("to")):
            print("repo-scope handoff requires --from <team> --to <team>", file=sys.stderr)
            sys.exit(1)
        if scope == "workbench" and (not flags.get("from-repo") or not flags.get("to-repo")):
            print("workbench-scope handoff requires --from-repo <repo> --to-repo <repo>", file=sys.stderr)
            sys.exit(1)
        existing = [f for f in list_dir_safe(handoffs_dir) if re.match(rf"^{prefix}-\d+-", f)]
        next_num = 1
        for f in existing:
            m = re.match(rf"^{prefix}-(\d+)-", f)
            if m:
                next_num = max(next_num, int(m.group(1)) + 1)
        handoff_id = f"{prefix}-{str(next_num).zfill(3)}"
        file = handoffs_dir / f"{handoff_id}-{flags['slug']}.md"
        fm_lines = ["---", f"handoff_id: {handoff_id}", f"scope: {scope}"]
        if scope == "repo":
            fm_lines.append(f"from_team: {flags['from']}")
            fm_lines.append(f"to_team: {flags['to']}")
        else:
            fm_lines.append(f"from_repo: {flags['from-repo']}")
            fm_lines.append(f"to_repo: {flags['to-repo']}")
        fm_lines.append(f"opened_at: {datetime.now(timezone.utc).isoformat()}")
        closes = flags.get("closes-when", "")
        fm_lines.append(f'closes_when: "{closes}"')
        fm_lines.append("blocking_phase_transitions: [verify]")
        fm_lines.append("---")
        title_subject = f"{flags['from']} → {flags['to']}" if scope == "repo" else f"{flags['from-repo']} → {flags['to-repo']}"
        body_lines = [
            "",
            f"# Handoff {handoff_id}: {title_subject}",
            "",
            f"Slug: {flags['slug']}",
            "",
            f"**Closes when:** {closes if closes else '(fill this in — required before close)'}",
            "",
        ]
        file.write_text("\n".join(fm_lines + body_lines))
        print(f"opened {handoff_id} → {file.relative_to(root)}")
        return

    if sub == "close":
        if len(clean_args) < 2:
            print('Usage: osengineer handoff close <id> [--reason "<text>"]', file=sys.stderr)
            sys.exit(1)
        handoff_id = clean_args[1]
        flags = parse_flags(clean_args[2:], ["reason"])
        files = [f for f in list_dir_safe(handoffs_dir) if f.startswith(f"{handoff_id}-") and f.endswith(".md")]
        if not files:
            print(f"osengineer: no handoff matching {handoff_id}", file=sys.stderr)
            sys.exit(1)
        if len(files) > 1:
            print(f"osengineer: multiple handoffs match {handoff_id}: {', '.join(files)}", file=sys.stderr)
            sys.exit(1)
        file = handoffs_dir / files[0]
        content = file.read_text()
        if re.search(r"closed_at:", content):
            print(f"{handoff_id} already closed")
            return
        reason = flags.get("reason", "(no reason given)")
        updated = update_frontmatter(content, {
            "closed_at": datetime.now(timezone.utc).isoformat(),
            "close_reason": f'"{reason.replace(chr(34), chr(92) + chr(34))}"',
        })
        file.write_text(updated)
        print(f"closed {handoff_id}")
        return

    if sub in ("list", ""):
        files = [f for f in list_dir_safe(handoffs_dir) if re.match(r"^(HO|XR)-\d+-", f) and f.endswith(".md")]
        if not files:
            print("no handoffs")
            return
        for f in files:
            content = (handoffs_dir / f).read_text()
            open_mark = "○" if not re.search(r"closed_at:", content) else "●"
            print(f"{open_mark} {f}")
        return

    print("Usage: osengineer handoff (open|close|list) ...", file=sys.stderr)
    sys.exit(1)


def discover_adrs(meta_path):
    candidates = [
        "documentation/adrs",
        "documentation/adr",
        "docs/adr",
        "docs/adrs",
        ".claude/adr-catalog",
    ]
    findings = []
    for sub in candidates:
        d = Path(meta_path) / sub
        if not d.is_dir():
            continue
        for f in list_dir_safe(d):
            m = re.match(r"^ADR-(\d{3})-(.+)\.md$", f, re.IGNORECASE)
            if not m:
                continue
            title = m.group(2).replace("-", " ")
            status = "unknown"
            try:
                content = (d / f).read_text()
                title_line = re.search(r"^#\s+(.+)$", content, re.MULTILINE)
                if title_line:
                    title = re.sub(r"^ADR-\d+:?\s*", "", title_line.group(1).strip())
                sm = re.search(r"^[\*\s|]*Status[\*\s|:]+\s*([A-Za-z ✅⚠️]+)", content, re.MULTILINE)
                if sm:
                    status = sm.group(1).strip().lower()
            except Exception:
                pass
            findings.append({
                "id": f"ADR-{m.group(1)}",
                "title": title,
                "status": status,
                "file": str(Path(sub) / f).replace("\\", "/"),
            })
    arc42 = Path(meta_path) / "documentation" / "09-architectural-decisions.md"
    if arc42.exists():
        try:
            content = arc42.read_text()
            blocks = re.split(r"^###\s+", content, flags=re.MULTILINE)[1:]
            for b in blocks:
                m = re.search(r"^ADR-(\d{3}):?\s*(.+?)$", b, re.MULTILINE)
                if not m:
                    continue
                adr_id = f"ADR-{m.group(1)}"
                if any(f["id"] == adr_id for f in findings):
                    continue
                status_match = re.search(r"Status[\*\s|:]+([A-Za-z ✅⚠️]+)", b)
                status = status_match.group(1).strip().lower() if status_match else "unknown"
                findings.append({
                    "id": adr_id,
                    "title": m.group(2).strip(),
                    "status": status,
                    "file": "documentation/09-architectural-decisions.md",
                })
        except Exception:
            pass
    findings.sort(key=lambda x: x["id"])
    return findings


def cmd_discover_adrs(args):
    if not args:
        print("Usage: osengineer discover-adrs <meta-path> [--out <file>]", file=sys.stderr)
        sys.exit(1)
    meta_path = Path(args[0])
    if not meta_path.exists():
        print(f"osengineer: {meta_path} does not exist", file=sys.stderr)
        sys.exit(1)
    findings = discover_adrs(meta_path)
    flags = parse_flags(args[1:], ["out"])
    lines = [
        "# osEngineer ADR catalog — generated from META repo",
        f"# Source: {meta_path}",
        f"# Generated: {datetime.now(timezone.utc).isoformat()}",
        "",
        "adrs:",
    ]
    for a in findings:
        lines.append(f"  - id: {a['id']}")
        lines.append(f'    title: "{a["title"].replace(chr(34), chr(92) + chr(34))}"')
        lines.append(f"    status: {a['status']}")
        lines.append(f"    file: {a['file']}")
    out = "\n".join(lines) + "\n"
    if flags.get("out"):
        out_path = Path(flags["out"])
        out_path.parent.mkdir(parents=True, exist_ok=True)
        out_path.write_text(out)
        print(f"wrote {len(findings)} ADR entries → {out_path}")
    else:
        print(out, end="")


# ── Evolution loop ───────────────────────────────────────────────────────────

def read_evolution_counter(repo_root):
    p = Path(repo_root) / ".osengineer" / "evolution-counter.yml"
    if not p.exists():
        return {"phases_since_last_evolution": 0, "total_evolutions_accepted": 0}
    raw = p.read_text()
    out = {"phases_since_last_evolution": 0, "total_evolutions_accepted": 0}
    m1 = re.search(r"^phases_since_last_evolution:\s*(\d+)", raw, re.MULTILINE)
    m2 = re.search(r"^total_evolutions_accepted:\s*(\d+)", raw, re.MULTILINE)
    if m1:
        out["phases_since_last_evolution"] = int(m1.group(1))
    if m2:
        out["total_evolutions_accepted"] = int(m2.group(1))
    return out


def write_evolution_counter(repo_root, fields):
    p = Path(repo_root) / ".osengineer" / "evolution-counter.yml"
    p.parent.mkdir(parents=True, exist_ok=True)
    existing = read_evolution_counter(repo_root)
    merged = {**existing, **fields}
    lines = [
        "# Incremented by osEngineer-post-commit hook. Auto-nudge fires at >= 5.",
        f"phases_since_last_evolution: {merged['phases_since_last_evolution']}",
        f"total_evolutions_accepted: {merged['total_evolutions_accepted']}",
    ]
    if merged.get("last_evolution_date"):
        lines.append(f"last_evolution_date: {merged['last_evolution_date']}")
    p.write_text("\n".join(lines) + "\n")


def list_proposals(repo_root):
    d = Path(repo_root) / ".osengineer" / "evolution-proposals"
    if not d.is_dir():
        return []
    return sorted([f for f in list_dir_safe(d) if re.match(r"^EP-\d+-", f) and f.endswith(".md")])


def cmd_evolve(args):
    repo_root = find_repo_root()
    if not repo_root:
        print("osengineer: not inside a git repo", file=sys.stderr)
        sys.exit(1)
    sub = args[0] if args else ""

    if not sub or sub == "status":
        c = read_evolution_counter(repo_root)
        proposals = list_proposals(repo_root)
        open_p = []
        closed = []
        for f in proposals:
            content = (Path(repo_root) / ".osengineer" / "evolution-proposals" / f).read_text()
            if re.search(r"^status:\s*(accepted|rejected)", content, re.MULTILINE):
                closed.append(f)
            else:
                open_p.append(f)
        print(f"phases_since_last_evolution: {c['phases_since_last_evolution']}")
        print(f"total_evolutions_accepted: {c['total_evolutions_accepted']}")
        if c["phases_since_last_evolution"] >= 5:
            print("⚙ counter ≥ 5 — consider proposing improvements")
        print(f"open proposals: {len(open_p)}")
        for f in open_p:
            print(f"  ○ {f}")
        print(f"closed proposals: {len(closed)}")
        for f in closed:
            print(f"  ● {f}")
        return

    if sub == "propose":
        flags = parse_flags(args[1:], ["title", "body-file", "body", "category"])
        if not flags.get("title"):
            print('Usage: osengineer evolve propose --title "<t>" [--body "<text>" | --body-file <f>] [--category <c>]', file=sys.stderr)
            sys.exit(1)
        d = Path(repo_root) / ".osengineer" / "evolution-proposals"
        d.mkdir(parents=True, exist_ok=True)
        existing = list_proposals(repo_root)
        next_num = 1
        for f in existing:
            m = re.match(r"^EP-(\d+)-", f)
            if m:
                next_num = max(next_num, int(m.group(1)) + 1)
        prop_id = f"EP-{str(next_num).zfill(3)}"
        slug = re.sub(r"[^a-z0-9]+", "-", flags["title"].lower()).strip("-")[:50]
        file = d / f"{prop_id}-{slug}.md"
        body = flags.get("body", "")
        if flags.get("body-file"):
            try:
                body = Path(flags["body-file"]).read_text()
            except Exception:
                print(f"osengineer: cannot read --body-file {flags['body-file']}", file=sys.stderr)
                sys.exit(1)
        content = [
            "---",
            f"proposal_id: {prop_id}",
            f'title: "{flags["title"].replace(chr(34), chr(92) + chr(34))}"',
            f"category: {flags.get('category', 'general')}",
            "status: open",
            f"opened_at: {datetime.now(timezone.utc).isoformat()}",
            f"opened_in_repo: {repo_root.name}",
            "---",
            "",
            f"# Evolution proposal {prop_id}: {flags['title']}",
            "",
            body if body else "(no body provided — fill this in before requesting acceptance)",
            "",
        ]
        file.write_text("\n".join(content))
        print(f"opened {prop_id} → {file.relative_to(repo_root)}")
        return

    if sub == "accept":
        if len(args) < 2:
            print('Usage: osengineer evolve accept <id> --pattern-slug <slug> [--pattern-file <f>]', file=sys.stderr)
            sys.exit(1)
        prop_id = args[1]
        flags = parse_flags(args[2:], ["pattern-slug", "pattern-file"])
        if not flags.get("pattern-slug"):
            print("--pattern-slug is required", file=sys.stderr)
            sys.exit(1)
        d = Path(repo_root) / ".osengineer" / "evolution-proposals"
        files = [f for f in list_dir_safe(d) if f.startswith(f"{prop_id}-") and f.endswith(".md")]
        if not files:
            print(f"osengineer: no proposal matching {prop_id}", file=sys.stderr)
            sys.exit(1)
        if len(files) > 1:
            print(f"osengineer: multiple proposals match {prop_id}: {', '.join(files)}", file=sys.stderr)
            sys.exit(1)
        file = d / files[0]
        original = file.read_text()
        updated = update_frontmatter(original, {
            "status": "accepted",
            "accepted_at": datetime.now(timezone.utc).isoformat(),
        })
        file.write_text(updated)
        pattern_file = SCRIPT_DIR / "memory" / "patterns" / f"{flags['pattern-slug']}.md"
        pattern_file.parent.mkdir(parents=True, exist_ok=True)
        if flags.get("pattern-file"):
            try:
                src = Path(flags["pattern-file"]).read_text()
                pattern_file.write_text(src)
            except Exception:
                print(f"osengineer: cannot read --pattern-file {flags['pattern-file']}", file=sys.stderr)
                sys.exit(1)
        else:
            stub_body = re.sub(r"^---\n[\s\S]*?\n---\n", "", original, flags=re.MULTILINE)
            stub = [
                f"# Pattern: {flags['pattern-slug']}",
                "",
                f"Promoted from evolution proposal {prop_id} in repo {repo_root.name} on {datetime.now(timezone.utc).isoformat()[:10]}.",
                "",
                stub_body,
            ]
            pattern_file.write_text("\n".join(stub))
        c = read_evolution_counter(repo_root)
        write_evolution_counter(repo_root, {
            "phases_since_last_evolution": 0,
            "total_evolutions_accepted": c["total_evolutions_accepted"] + 1,
            "last_evolution_date": datetime.now(timezone.utc).isoformat()[:10],
        })
        print(f"accepted {prop_id} → memory/patterns/{flags['pattern-slug']}.md")
        print(f"counter reset to 0; total accepted = {c['total_evolutions_accepted'] + 1}")
        return

    if sub == "reject":
        if len(args) < 2:
            print('Usage: osengineer evolve reject <id> --reason "<text>"', file=sys.stderr)
            sys.exit(1)
        prop_id = args[1]
        flags = parse_flags(args[2:], ["reason"])
        if not flags.get("reason"):
            print("--reason is required", file=sys.stderr)
            sys.exit(1)
        d = Path(repo_root) / ".osengineer" / "evolution-proposals"
        files = [f for f in list_dir_safe(d) if f.startswith(f"{prop_id}-") and f.endswith(".md")]
        if not files:
            print(f"osengineer: no proposal matching {prop_id}", file=sys.stderr)
            sys.exit(1)
        file = d / files[0]
        original = file.read_text()
        updated = re.sub(r"^status:\s*open", "status: rejected", original, flags=re.MULTILINE)
        updated = re.sub(
            r"^(---\n[\s\S]*?)(\n---)",
            r"\1\nrejected_at: " + datetime.now(timezone.utc).isoformat() + r"\nreject_reason: \"" + flags["reason"].replace('"', '\\"') + r"\"\2",
            updated,
            flags=re.MULTILINE,
        )
        file.write_text(updated)
        log_path = Path(repo_root) / ".osengineer" / "evolution-rejections.jsonl"
        entry = json.dumps({
            "proposal_id": prop_id,
            "rejected_at": datetime.now(timezone.utc).isoformat(),
            "reason": flags["reason"],
        }) + "\n"
        with open(log_path, "a") as f:
            f.write(entry)
        c = read_evolution_counter(repo_root)
        write_evolution_counter(repo_root, {
            "phases_since_last_evolution": 0,
            "total_evolutions_accepted": c["total_evolutions_accepted"],
            "last_evolution_date": datetime.now(timezone.utc).isoformat()[:10],
        })
        print(f"rejected {prop_id} (reason logged); counter reset to 0")
        return

    print("Usage: osengineer evolve (status|propose|accept|reject) ...", file=sys.stderr)
    sys.exit(1)


# ── Scaffold ─────────────────────────────────────────────────────────────────

def cmd_scaffold(args):
    sub = args[0] if args else ""
    if sub == "agent":
        return cmd_scaffold_agent(args[1:])
    if sub == "command":
        return cmd_scaffold_command(args[1:])
    print("Usage: osengineer scaffold (agent|command) <name> [flags]", file=sys.stderr)
    sys.exit(1)


def cmd_scaffold_agent(args):
    if not args:
        print('Usage: osengineer scaffold agent <name> [--role <r>] [--scope <s>] [--escalates-to <list>] [--out <path>]', file=sys.stderr)
        sys.exit(1)
    name = args[0]
    if not re.match(r"^[a-z][a-z0-9-]*$", name):
        print('osengineer: agent name must be lowercase-with-hyphens, e.g. "my-agent"', file=sys.stderr)
        sys.exit(1)
    flags = parse_flags(args[1:], ["role", "scope", "escalates-to", "out"])
    template = SCRIPT_DIR / "templates" / "agent.md.tmpl"
    if not template.exists():
        print(f"osengineer: template missing — {template}", file=sys.stderr)
        sys.exit(1)
    title = " ".join(w.capitalize() for w in name.split("-"))
    out = template.read_text()
    out = out.replace("{{NAME}}", name)
    out = out.replace("{{TITLE}}", title)
    out = out.replace("{{ROLE}}", flags.get("role", "implementer"))
    out = out.replace("{{SCOPE}}", flags.get("scope", "team"))
    out = out.replace("{{ESCALATES_TO}}", flags.get("escalates-to", "architect"))
    dst = Path(flags["out"]) if flags.get("out") else SCRIPT_DIR / "agents" / f"{name}.md"
    if dst.exists():
        print(f"osengineer: {dst} already exists — refusing to overwrite. Use --out to redirect.", file=sys.stderr)
        sys.exit(1)
    dst.parent.mkdir(parents=True, exist_ok=True)
    dst.write_text(out)
    print(f"scaffolded {dst.relative_to(SCRIPT_DIR)}")
    print("Next steps:")
    print(f"  1. Fill in the TODO sections in {dst.name} (description verbs, mandate, protocol).")
    print(f'  2. If this agent should ship to every initialised repo, add "{name}.md" to MANDATORY_AGENTS in install.sh.')
    print("  3. Add a one-line entry under the right section of agents/INDEX.md.")


def cmd_scaffold_command(args):
    if not args:
        print('Usage: osengineer scaffold command <name> [--phase-allowed <list>] [--phase-after <p>]', file=sys.stderr)
        sys.exit(1)
    name = args[0]
    if not re.match(r"^[a-z][a-z0-9-]*$", name):
        print('osengineer: command name must be lowercase-with-hyphens', file=sys.stderr)
        sys.exit(1)
    flags = parse_flags(args[1:], ["phase-allowed", "phase-after", "out"])
    template = SCRIPT_DIR / "templates" / "command.md.tmpl"
    if not template.exists():
        print(f"osengineer: template missing — {template}", file=sys.stderr)
        sys.exit(1)
    out = template.read_text()
    out = out.replace("{{NAME}}", name)
    out = out.replace("{{PHASE_ALLOWED}}", flags.get("phase-allowed", "execute"))
    out = out.replace("{{PHASE_AFTER}}", flags.get("phase-after", "null"))
    dst = Path(flags["out"]) if flags.get("out") else SCRIPT_DIR / "commands" / f"osEngineer-{name}.md"
    if dst.exists():
        print(f"osengineer: {dst} already exists — refusing to overwrite. Use --out to redirect.", file=sys.stderr)
        sys.exit(1)
    dst.parent.mkdir(parents=True, exist_ok=True)
    dst.write_text(out)
    print(f"scaffolded {dst.relative_to(SCRIPT_DIR)}")
    print("Next steps:")
    print(f"  1. Fill in the TODO sections in {dst.name} (description verbs, steps, example).")
    print("  2. Add a one-line entry under commands/INDEX.md.")


def cmd_explain(args):
    topic = args[0] if args else "overview"
    messages = {
        "overview": (
            "osEngineer — a real-enforcement, multi-repo engineering skill.\n"
            "Three-level nesting: workbench → repo → team. Each level has an\n"
            "AGENTS.md (architect) and a .osengineer/ (state). Runtime enforcement\n"
            "via git hooks + Claude hooks + this CLI + CI status checks."
        ),
        "phases": (
            "Phase lifecycle: idle → discuss → plan → execute → verify → accepted.\n"
            "Micro-Phase (Hotfix): idle → micro (or hotfix) → accepted (lightweight cycle).\n"
            "`blocked` is a side-state entered on budget overrun or hard-rule violation.\n"
            "Transitions are gated by hooks: no execute without PHASE_PLAN.md, no\n"
            "verify without green test run, no merge without VERIFICATION.md (or MICRO_PLAN.md)."
        ),
        "hooks": (
            "Ten enforcement hooks live in hooks/osEngineer-*. install.sh copies\n"
            "the git hooks into .git/hooks/ and wires the Claude hooks via\n"
            "absolute path in .claude/settings.json. Bypass any hook with\n"
            "OSE_BYPASS=1 (logged to .osengineer/bypass-log.jsonl)."
        ),
        "teams": (
            "Five teams per repo: coding / testing / infra / docs / security.\n"
            "install.sh auto-detects folder ownership from go.mod, ansible/,\n"
            "*_test.go, docs/, .github/codeql etc., and writes both the YAML\n"
            "in AGENTS.md AND a JSON cache in .osengineer/teams/<team>.json that\n"
            "osEngineer-pre-edit-guard reads to enforce owns_paths at edit time.\n"
            "Cross-team handoffs live in .osengineer/handoffs/HO-<n>-*.md and\n"
            "are managed via `osengineer handoff (open|close|list)`."
        ),
        "handoffs": (
            "Handoffs are filesystem-tracked tickets between teams. When team A\n"
            "needs team B to act first, A runs:\n"
            "  osengineer handoff open --from <A> --to <B> --slug <s> --closes-when \"<text>\"\n"
            "and the architect agent watches the directory. Verify-phase transitions\n"
            "are blocked while any handoff is open."
        ),
        "scaffold": (
            "Materialise a new agent or command file from templates/:\n"
            "  osengineer scaffold agent <name> --role <r> --scope <s> --escalates-to <list>\n"
            "  osengineer scaffold command <name> --phase-allowed <list> --phase-after <p>\n"
            "Refuses to overwrite existing files. Templates live in templates/agent.md.tmpl\n"
            "and templates/command.md.tmpl. Both enforce the frontmatter convention\n"
            "documented in templates/frontmatter-pattern.md."
        ),
        "evolution": (
            "Evolution loop: the post-commit hook increments\n"
            ".osengineer/evolution-counter.yml; at >= 5 the session-start banner\n"
            "auto-nudges. Propose an improvement with\n"
            "  osengineer evolve propose --title \"<t>\" --body \"<text>\"\n"
            "Accept with `osengineer evolve accept <id> --pattern-slug <s>` (promotes\n"
            "to memory/patterns/) or `osengineer evolve reject <id> --reason \"<r>\"`\n"
            "(logged to evolution-rejections.jsonl). Either action resets the counter."
        ),
    }
    msg = messages.get(topic)
    if not msg:
        print(f'Unknown topic "{topic}". Available: {", ".join(messages.keys())}')
        sys.exit(1)
    print(msg)


def usage():
    print(
        f"osengineer {VERSION}\n\n"
        "Usage:\n"
        "  osengineer init <path>                  Initialise a repo with osEngineer wiring\n"
        "  osengineer state                        Show .osengineer/state.yml fields\n"
        "  osengineer state set <k> <v>            Update a state.yml field\n"
        "  osengineer detect-teams <path>          Auto-detect team→folder mapping (outputs YAML)\n"
        "  osengineer handoff open --from <t> --to <t> --slug <s> [--closes-when \"<text>\"]\n"
        "  osengineer handoff close <id> [--reason \"<text>\"]\n"
        "  osengineer handoff list\n"
        "  osengineer discover-adrs <meta-path> [--out <file>]\n"
        "                                          Scan a META repo for ADRs; emit YAML catalog\n"
        "  osengineer evolve [status]               Show counter + open/closed proposals\n"
        "  osengineer evolve propose --title \"<t>\" [--body \"<text>\" | --body-file <f>] [--category <c>]\n"
        "  osengineer evolve accept <id> --pattern-slug <s> [--pattern-file <f>]\n"
        "                                          Promote proposal to memory/patterns/<s>.md; reset counter\n"
        "  osengineer evolve reject <id> --reason \"<text>\"\n"
        "                                          Log rejection; reset counter\n"
        "  osengineer scaffold agent <name> [--role <r>] [--scope <s>] [--escalates-to <list>]\n"
        "                                          Materialise a new agent file from template\n"
        "  osengineer scaffold command <name> [--phase-allowed <list>] [--phase-after <p>]\n"
        "                                          Materialise a new command file from template\n"
        "  osengineer version                      Print osEngineer version\n"
        "  osengineer explain [topic]              overview|phases|hooks|teams|handoffs|scaffold"
    )


# ── Dispatch ─────────────────────────────────────────────────────────────────

def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("help", "--help", "-h"):
        usage()
        sys.exit(0 if not argv else 0)
    sub = argv[0]
    rest = argv[1:]
    if sub in ("version", "--version", "-v"):
        cmd_version()
    elif sub == "init":
        cmd_init(rest)
    elif sub == "state":
        cmd_state(rest)
    elif sub == "detect-teams":
        cmd_detect_teams(rest)
    elif sub == "handoff":
        cmd_handoff(rest)
    elif sub == "discover-adrs":
        cmd_discover_adrs(rest)
    elif sub == "evolve":
        cmd_evolve(rest)
    elif sub == "scaffold":
        cmd_scaffold(rest)
    elif sub == "explain":
        cmd_explain(rest)
    else:
        print(f'osengineer: unknown subcommand "{sub}"\n', file=sys.stderr)
        usage()
        sys.exit(1)


if __name__ == "__main__":
    main()
