#!/usr/bin/env node
// osengineer — the osEngineer skill CLI.
//
// Subcommands:
//   init <path>                       Run install.sh on a repo or workbench
//   state                             Show current phase/team/budget
//   state set <k> <v>                 Update a state.yml field
//   detect-teams <path>               Auto-detect folder→team mapping
//                                     (Go modules → coding, ansible/ → infra,
//                                      *_test.go → testing, docs/ → docs,
//                                      .github/codeql or security/ → security).
//                                     Outputs YAML to stdout suitable for the
//                                     `teams:` block of a repo AGENTS.md.
//   handoff open --from <t> --to <t> --slug <s> [--closes-when "<text>"]
//                                     Open a cross-team handoff ticket.
//   handoff close <id> [--reason "<text>"]
//                                     Close an open handoff.
//   handoff list                      List open handoffs in cwd repo.
//   version                           Print the osEngineer version.
//   explain [topic]                   Print concept explanation.
//
// Wiring (hooks, agents) is owned by install.sh. This CLI deals with runtime
// state, team detection, and handoff lifecycle.

'use strict';

const fs = require('fs');
const path = require('path');
const { spawnSync } = require('child_process');

const SCRIPT_DIR = path.resolve(__dirname, '..');
const VERSION_FILE = path.join(SCRIPT_DIR, 'VERSION');
const VERSION = fs.existsSync(VERSION_FILE)
  ? fs.readFileSync(VERSION_FILE, 'utf8').trim()
  : '0.0.0-dev';

// ── Helpers ────────────────────────────────────────────────────────────────

function findRepoRoot(cwd) {
  let current = cwd;
  for (let i = 0; i < 8; i++) {
    if (fs.existsSync(path.join(current, '.git'))) return current;
    const parent = path.dirname(current);
    if (parent === current) break;
    current = parent;
  }
  return null;
}

// Find the nearest osEngineer-initialised root walking up from cwd.
// Returns { root, scope } where scope is 'workbench' (has .osengineer/ but
// no .git) or 'repo' (has both). Returns null if neither found.
function findOsEngineerRoot(cwd) {
  let current = cwd;
  for (let i = 0; i < 8; i++) {
    if (fs.existsSync(path.join(current, '.osengineer'))) {
      const isRepo = fs.existsSync(path.join(current, '.git'));
      return { root: current, scope: isRepo ? 'repo' : 'workbench' };
    }
    const parent = path.dirname(current);
    if (parent === current) break;
    current = parent;
  }
  return null;
}

function readWorkbenchConfig(workbenchRoot) {
  const p = path.join(workbenchRoot, '.osengineer', 'workbench-config.yml');
  if (!fs.existsSync(p)) return null;
  const raw = fs.readFileSync(p, 'utf8');
  const config = {};
  let currentArray = null;
  let currentArrayKey = null;
  let indentStack = [];
  for (const line of raw.split('\n')) {
    if (/^\s*#/.test(line) || line.trim() === '') continue;
    const topKey = line.match(/^(\w+):\s*(.*)$/);
    if (topKey && !line.startsWith(' ') && !line.startsWith('-')) {
      currentArray = null;
      config[topKey[1]] = topKey[2].trim().replace(/^["']|["']$/g, '');
      if (topKey[2].trim() === '') {
        // Might be an object or array starting on next lines
        config[topKey[1]] = [];
        currentArray = config[topKey[1]];
        currentArrayKey = topKey[1];
      }
      continue;
    }
    const arrayItem = line.match(/^\s+- (\w+):\s*(.*)$/);
    if (arrayItem && currentArray) {
      currentArray.push({ [arrayItem[1]]: arrayItem[2].trim().replace(/^["']|["']$/g, '') });
      continue;
    }
    const nestedKey = line.match(/^\s+(\w+):\s*(.*)$/);
    if (nestedKey && currentArray && currentArray.length > 0) {
      const last = currentArray[currentArray.length - 1];
      if (typeof last === 'object') {
        last[nestedKey[1]] = nestedKey[2].trim().replace(/^["']|["']$/g, '');
      }
    }
  }
  // Fix: if top-level keys were mistakenly turned into arrays, restore scalar values
  for (const k of Object.keys(config)) {
    if (Array.isArray(config[k]) && config[k].length === 0) delete config[k];
  }
  return config;
}

function readStateMap(repoRoot) {
  const p = path.join(repoRoot, '.osengineer', 'state.yml');
  if (!fs.existsSync(p)) return null;
  const raw = fs.readFileSync(p, 'utf8');
  const state = {};
  for (const line of raw.split('\n')) {
    const m = line.match(/^(\w+):\s*(.*)$/);
    if (!m) continue;
    state[m[1]] = m[2].trim().replace(/^["']|["']$/g, '');
  }
  return state;
}

function writeStateField(repoRoot, key, value) {
  const p = path.join(repoRoot, '.osengineer', 'state.yml');
  if (!fs.existsSync(p)) {
    fs.mkdirSync(path.dirname(p), { recursive: true });
    fs.writeFileSync(p, `${key}: ${value}\n`);
    return;
  }
  const lines = fs.readFileSync(p, 'utf8').split('\n');
  let found = false;
  for (let i = 0; i < lines.length; i++) {
    if (new RegExp('^' + key + ':').test(lines[i])) {
      lines[i] = `${key}: ${value}`;
      found = true;
      break;
    }
  }
  if (!found) lines.push(`${key}: ${value}`);
  fs.writeFileSync(p, lines.join('\n'));
}

function listDirSafe(dir) {
  try { return fs.readdirSync(dir); } catch { return []; }
}

function hasAny(repo, ...patterns) {
  return patterns.some(p => fs.existsSync(path.join(repo, p)));
}

function hasDir(repo, ...patterns) {
  return patterns.some(p => {
    const full = path.join(repo, p);
    try { return fs.statSync(full).isDirectory(); }
    catch { return false; }
  });
}

function hasFileMatching(repo, regex, depth = 3) {
  const stack = [{ dir: repo, depth: 0 }];
  while (stack.length > 0) {
    const { dir, depth: d } = stack.pop();
    if (d > depth) continue;
    for (const name of listDirSafe(dir)) {
      if (name === '.git' || name === 'node_modules' || name === 'vendor' ||
          name === 'graphify-out' || name === '.osengineer') continue;
      const full = path.join(dir, name);
      let stat;
      try { stat = fs.statSync(full); } catch { continue; }
      if (stat.isDirectory()) stack.push({ dir: full, depth: d + 1 });
      else if (regex.test(name)) return true;
    }
  }
  return false;
}

// ── Subcommands ────────────────────────────────────────────────────────────

function cmdVersion() {
  process.stdout.write(`osengineer ${VERSION}\n`);
}

function cmdState(args) {
  const repoRoot = findRepoRoot(process.cwd());
  if (args[0] === 'set') {
    if (!repoRoot) { console.error('osengineer: not inside a git repo'); process.exit(1); }
    const [, key, ...rest] = args;
    if (!key || rest.length === 0) {
      console.error('Usage: osengineer state set <key> <value>'); process.exit(1);
    }
    writeStateField(repoRoot, key, rest.join(' '));
    process.stdout.write(`set ${key} = ${rest.join(' ')}\n`);
    return;
  }
  if (!repoRoot) { console.error('osengineer: not inside a git repo'); process.exit(1); }
  const state = readStateMap(repoRoot);
  if (!state) {
    process.stdout.write('No .osengineer/ directory. Run install.sh first.\n');
    process.exit(0);
  }
  for (const [k, v] of Object.entries(state)) process.stdout.write(`${k}: ${v}\n`);
}

function cmdInit(args) {
  const target = args[0] || process.cwd();
  if (!fs.existsSync(target)) {
    console.error(`osengineer: ${target} does not exist`); process.exit(1);
  }
  const installScript = path.join(SCRIPT_DIR, 'install.sh');
  if (!fs.existsSync(installScript)) {
    console.error(`osengineer: install.sh not found at ${installScript}`); process.exit(1);
  }
  // Detect workbench vs single repo: target IS a repo if it has .git/;
  // target is a workbench if it has no .git/ but has child dirs with .git/.
  const isRepo = fs.existsSync(path.join(target, '.git'));
  const installArgs = isRepo ? [installScript, target] : [installScript, '--workbench', target];
  const result = spawnSync('bash', installArgs, { stdio: 'inherit' });
  process.exit(result.status ?? 1);
}

function detectTeams(repo) {
  // Probes the repo for evidence of each team's relevance + suggested ownership.
  // Returns an array of team objects matching the agents-md.schema.json `teams` shape.
  const teams = [];

  const hasGo      = hasAny(repo, 'go.mod');
  const hasPython  = hasAny(repo, 'pyproject.toml', 'setup.py', 'requirements.txt');
  const hasNode    = hasAny(repo, 'package.json');
  const hasRust    = hasAny(repo, 'Cargo.toml');
  const hasAnsible = hasDir(repo, 'ansible', 'roles', 'playbooks');
  const hasCompose = hasFileMatching(repo, /^docker-compose.*\.ya?ml$/);
  const hasSrcDir  = hasDir(repo, 'src', 'internal', 'cmd', 'pkg');
  const hasTestsDir = hasDir(repo, 'test', 'tests', 'integration', 'e2e');
  const hasGoTests = hasFileMatching(repo, /^.+_test\.go$/);
  const hasPyTests = hasFileMatching(repo, /^test_.+\.py$/);
  const hasDocs    = hasDir(repo, 'docs') || hasAny(repo, 'README.md', 'README.rst');
  const hasContracts = hasDir(repo, 'contracts') || hasFileMatching(repo, /^.+\.openapi\.ya?ml$/);
  const hasCodeQL  = hasDir(repo, '.github/codeql');
  const hasSecurityDir = hasDir(repo, 'security');

  // Coding team
  const codingPaths = [];
  if (hasGo) { codingPaths.push('internal/**', 'cmd/**', 'pkg/**'); }
  if (hasPython || hasNode || hasRust) codingPaths.push('src/**');
  if (hasSrcDir && codingPaths.length === 0) codingPaths.push('src/**');
  if (codingPaths.length > 0) {
    teams.push({
      team_id: 'coding',
      folder: hasGo && hasDir(repo, 'internal') ? 'internal/' : (hasDir(repo, 'src') ? 'src/' : null),
      agents: ['developer', 'reviewer'],
      owns_paths: codingPaths,
      reads_paths: ['api/**', 'contracts/**', 'ansible/**', 'docs/**'],
      escalates_to: ['testing', 'infra', 'docs', 'security'],
    });
  }

  // Testing team (glob-only is common for Go)
  const testingPaths = [];
  if (hasGoTests) testingPaths.push('**/*_test.go');
  if (hasPyTests) testingPaths.push('**/test_*.py');
  if (hasTestsDir) testingPaths.push('tests/**', 'test/**', 'integration/**', 'e2e/**');
  if (testingPaths.length > 0) {
    teams.push({
      team_id: 'testing',
      folder: hasTestsDir ? (fs.existsSync(path.join(repo, 'tests')) ? 'tests/' : 'test/') : null,
      agents: ['qa'],
      owns_paths: testingPaths,
      reads_paths: ['internal/**', 'cmd/**', 'pkg/**', 'src/**', 'api/**', 'contracts/**'],
      escalates_to: ['coding'],
    });
  }

  // Infra team
  const infraPaths = [];
  if (hasAnsible) infraPaths.push('ansible/**', 'roles/**', 'playbooks/**');
  if (hasCompose) infraPaths.push('docker-compose*.yml', 'Dockerfile*');
  if (hasDir(repo, 'scripts')) infraPaths.push('scripts/**');
  if (hasDir(repo, '.github/workflows')) infraPaths.push('.github/workflows/**');
  if (infraPaths.length > 0) {
    teams.push({
      team_id: 'infra',
      folder: hasAnsible ? 'ansible/' : null,
      agents: ['topology-validator', 'live-system-operator', 'cert-monitor', 'health-verifier'],
      owns_paths: infraPaths,
      reads_paths: ['**/*.yml', '**/Dockerfile', 'service-manifest.yml', 'contracts/**'],
      escalates_to: ['coding', 'security', 'docs'],
    });
  }

  // Docs team
  const docsPaths = [];
  if (hasDocs) docsPaths.push('docs/**', 'README*.md');
  if (hasContracts) docsPaths.push('contracts/**', '**/*.openapi.yaml', '**/*.openapi.yml');
  docsPaths.push('**/*.schema.json', 'service-manifest.yml', 'message-contract*.yaml');
  teams.push({
    team_id: 'docs',
    folder: hasDir(repo, 'docs') ? 'docs/' : null,
    agents: ['tech-writer'],
    owns_paths: docsPaths,
    reads_paths: ['**'],
    escalates_to: ['coding', 'infra', 'security'],
  });

  // Security team (always present, owns the small SAST/secret-scan surface)
  const securityPaths = ['.github/codeql/**', 'security/**', '.secretscanignore', '.base64scanignore'];
  teams.push({
    team_id: 'security',
    folder: hasCodeQL ? '.github/codeql/' : (hasSecurityDir ? 'security/' : null),
    agents: ['red-team-local', 'red-team-architect'],
    owns_paths: securityPaths,
    reads_paths: ['**'],
    escalates_to: ['coding', 'infra', 'docs'],
  });

  return teams;
}

function teamsToYamlBlock(teams, indent = '  ') {
  const lines = [];
  for (const t of teams) {
    lines.push(`${indent}- team_id: ${t.team_id}`);
    lines.push(`${indent}  folder: ${t.folder === null ? 'null' : t.folder}`);
    lines.push(`${indent}  agents: [${t.agents.join(', ')}]`);
    lines.push(`${indent}  owns_paths:`);
    for (const p of t.owns_paths) lines.push(`${indent}    - "${p}"`);
    lines.push(`${indent}  reads_paths:`);
    for (const p of t.reads_paths) lines.push(`${indent}    - "${p}"`);
    lines.push(`${indent}  escalates_to: [${t.escalates_to.join(', ')}]`);
  }
  return lines.join('\n');
}

function cmdDetectTeams(args) {
  const target = args[0] || process.cwd();
  if (!fs.existsSync(target)) {
    console.error(`osengineer: ${target} does not exist`); process.exit(1);
  }
  const teams = detectTeams(target);
  process.stdout.write(teamsToYamlBlock(teams) + '\n');
  // Also write a JSON cache for hooks (machine-friendly, no YAML parsing needed)
  const cacheDir = path.join(target, '.osengineer', 'teams');
  if (fs.existsSync(path.join(target, '.osengineer'))) {
    fs.mkdirSync(cacheDir, { recursive: true });
    for (const t of teams) {
      fs.writeFileSync(
        path.join(cacheDir, `${t.team_id}.json`),
        JSON.stringify(t, null, 2) + '\n'
      );
    }
  }
}

function cmdHandoff(args) {
  // Detect scope automatically from cwd: workbench scope uses XR-* tickets,
  // repo scope uses HO-* tickets. User can override with --scope workbench|repo.
  const ose = findOsEngineerRoot(process.cwd());
  if (!ose) {
    console.error('osengineer: cwd is not inside an osEngineer-initialised workbench or repo');
    process.exit(1);
  }

  // Allow --scope override (must consume early)
  const scopeOverride = parseFlags(args, ['scope']).scope;
  const scope = scopeOverride || ose.scope;
  if (!['workbench', 'repo'].includes(scope)) {
    console.error(`osengineer: invalid --scope "${scope}" (must be workbench or repo)`);
    process.exit(1);
  }
  const prefix = scope === 'workbench' ? 'XR' : 'HO';
  const handoffsDir = path.join(ose.root, '.osengineer', 'handoffs');
  fs.mkdirSync(handoffsDir, { recursive: true });

  // Strip --scope flag from args so subcommand parsing isn't confused
  const cleanArgs = [];
  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--scope') { i++; continue; }
    cleanArgs.push(args[i]);
  }
  const sub = cleanArgs[0];

  if (sub === 'open') {
    const allowed = ['from', 'to', 'slug', 'closes-when', 'from-repo', 'to-repo'];
    const flags = parseFlags(cleanArgs.slice(1), allowed);
    if (!flags.slug) {
      console.error('Usage: osengineer handoff open --slug <s> [--from <team>] [--to <team>] [--from-repo <r>] [--to-repo <r>] [--closes-when "<text>"]');
      process.exit(1);
    }
    if (scope === 'repo' && (!flags.from || !flags.to)) {
      console.error('repo-scope handoff requires --from <team> --to <team>');
      process.exit(1);
    }
    if (scope === 'workbench' && (!flags['from-repo'] || !flags['to-repo'])) {
      console.error('workbench-scope handoff requires --from-repo <r> --to-repo <r>');
      process.exit(1);
    }
    const existing = listDirSafe(handoffsDir).filter(f => new RegExp(`^${prefix}-\\d+-`).test(f));
    let nextNum = 1;
    for (const f of existing) {
      const m = f.match(new RegExp(`^${prefix}-(\\d+)-`));
      if (m) nextNum = Math.max(nextNum, parseInt(m[1], 10) + 1);
    }
    const id = `${prefix}-${String(nextNum).padStart(3, '0')}`;
    const file = path.join(handoffsDir, `${id}-${flags.slug}.md`);
    const fmLines = [
      '---',
      `handoff_id: ${id}`,
      `scope: ${scope}`,
    ];
    if (scope === 'repo') {
      fmLines.push(`from_team: ${flags.from}`);
      fmLines.push(`to_team: ${flags.to}`);
    } else {
      fmLines.push(`from_repo: ${flags['from-repo']}`);
      fmLines.push(`to_repo: ${flags['to-repo']}`);
    }
    fmLines.push(`opened_at: ${new Date().toISOString()}`);
    fmLines.push(flags['closes-when'] ? `closes_when: "${flags['closes-when']}"` : 'closes_when: ""');
    fmLines.push('blocking_phase_transitions: [verify]');
    fmLines.push('---');
    fmLines.push('');
    const titleSubject = scope === 'repo'
      ? `${flags.from} → ${flags.to}`
      : `${flags['from-repo']} → ${flags['to-repo']}`;
    fmLines.push(`# Handoff ${id}: ${titleSubject}`);
    fmLines.push('');
    fmLines.push(`Slug: ${flags.slug}`);
    fmLines.push('');
    fmLines.push(flags['closes-when']
      ? `**Closes when:** ${flags['closes-when']}`
      : '**Closes when:** (fill this in — required before close)');
    fmLines.push('');
    fs.writeFileSync(file, fmLines.join('\n'));
    process.stdout.write(`opened ${id} → ${path.relative(ose.root, file)}\n`);
    return;
  }

  if (sub === 'close') {
    const id = cleanArgs[1];
    if (!id) { console.error('Usage: osengineer handoff close <id> [--reason "<text>"]'); process.exit(1); }
    const flags = parseFlags(cleanArgs.slice(2), ['reason']);
    const files = listDirSafe(handoffsDir).filter(f => f.startsWith(`${id}-`) && f.endsWith('.md'));
    if (files.length === 0) { console.error(`osengineer: no handoff matching ${id}`); process.exit(1); }
    if (files.length > 1) { console.error(`osengineer: multiple handoffs match ${id}: ${files.join(', ')}`); process.exit(1); }
    const file = path.join(handoffsDir, files[0]);
    const content = fs.readFileSync(file, 'utf8');
    if (/closed_at:/.test(content)) {
      process.stdout.write(`${id} already closed\n`); return;
    }
    const reason = flags.reason || '(no reason given)';
    const updated = updateFrontmatter(content, {
      closed_at: new Date().toISOString(),
      close_reason: `"${reason.replace(/"/g, '\\"')}"`,
    });
    fs.writeFileSync(file, updated);
    process.stdout.write(`closed ${id}\n`);
    return;
  }

  if (sub === 'list' || !sub) {
    const files = listDirSafe(handoffsDir).filter(f => /^(HO|XR)-\d+-/.test(f) && f.endsWith('.md'));
    if (files.length === 0) { process.stdout.write('no handoffs\n'); return; }
    for (const f of files) {
      const content = fs.readFileSync(path.join(handoffsDir, f), 'utf8');
      const open = !/closed_at:/.test(content);
      process.stdout.write(`${open ? '○' : '●'} ${f}\n`);
    }
    return;
  }

  console.error('Usage: osengineer handoff (open|close|list) ...');
  process.exit(1);
}

// Discover ADRs in a META repo by scanning known locations. Writes a YAML
// catalog to <workbench>/.osengineer/adr-catalog.yml if cwd has an .osengineer/.
function discoverAdrs(metaPath) {
  const candidates = [
    'documentation/adrs',
    'documentation/adr',
    'docs/adr',
    'docs/adrs',
    '.claude/adr-catalog',
  ];
  const findings = [];
  for (const sub of candidates) {
    const dir = path.join(metaPath, sub);
    if (!fs.existsSync(dir)) continue;
    for (const f of listDirSafe(dir)) {
      const m = f.match(/^ADR-(\d{3})-(.+)\.md$/i);
      if (!m) continue;
      let title = m[2].replace(/-/g, ' ');
      let status = 'unknown';
      try {
        const content = fs.readFileSync(path.join(dir, f), 'utf8');
        const titleLine = content.match(/^#\s+(.+)$/m);
        if (titleLine) title = titleLine[1].trim().replace(/^ADR-\d+:?\s*/, '');
        const sm = content.match(/^[*\s|]*Status[*\s|:]+\s*([A-Za-z ✅⚠️]+)/m);
        if (sm) status = sm[1].trim().toLowerCase();
      } catch {}
      findings.push({
        id: `ADR-${m[1]}`,
        title,
        status,
        file: path.relative(metaPath, path.join(dir, f)).replace(/\\/g, '/'),
      });
    }
  }
  // Also parse consolidated arc42 section 9 if present
  const arc42 = path.join(metaPath, 'documentation/09-architectural-decisions.md');
  if (fs.existsSync(arc42)) {
    try {
      const content = fs.readFileSync(arc42, 'utf8');
      const blocks = content.split(/^###\s+/m).slice(1);
      for (const b of blocks) {
        const m = b.match(/^ADR-(\d{3}):?\s*(.+?)$/m);
        if (!m) continue;
        const id = `ADR-${m[1]}`;
        if (findings.some(f => f.id === id)) continue; // prefer individual file
        const status = (b.match(/Status[*\s|:]+([A-Za-z ✅⚠️]+)/) || [, 'unknown'])[1].trim().toLowerCase();
        findings.push({
          id, title: m[2].trim(), status,
          file: 'documentation/09-architectural-decisions.md',
        });
      }
    } catch {}
  }
  findings.sort((a, b) => a.id.localeCompare(b.id));
  return findings;
}

function cmdDiscoverAdrs(args) {
  const metaPath = args[0];
  if (!metaPath) {
    console.error('Usage: osengineer discover-adrs <meta-path> [--out <file>]');
    process.exit(1);
  }
  if (!fs.existsSync(metaPath)) {
    console.error(`osengineer: ${metaPath} does not exist`); process.exit(1);
  }
  const findings = discoverAdrs(metaPath);
  const flags = parseFlags(args.slice(1), ['out']);
  const lines = [
    '# osEngineer ADR catalog — generated from META repo',
    `# Source: ${metaPath}`,
    `# Generated: ${new Date().toISOString()}`,
    '',
    'adrs:',
  ];
  for (const a of findings) {
    lines.push(`  - id: ${a.id}`);
    lines.push(`    title: "${a.title.replace(/"/g, '\\"')}"`);
    lines.push(`    status: ${a.status}`);
    lines.push(`    file: ${a.file}`);
  }
  const out = lines.join('\n') + '\n';
  if (flags.out) {
    fs.mkdirSync(path.dirname(flags.out), { recursive: true });
    fs.writeFileSync(flags.out, out);
    process.stdout.write(`wrote ${findings.length} ADR entries → ${flags.out}\n`);
  } else {
    process.stdout.write(out);
  }
}

function parseFlags(args, allowed) {
  const out = {};
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (!a.startsWith('--')) continue;
    const eq = a.indexOf('=');
    const key = eq !== -1 ? a.slice(2, eq) : a.slice(2);
    if (!allowed.includes(key)) continue;
    if (eq !== -1) {
      out[key] = a.slice(eq + 1);
    } else if (i + 1 < args.length && !args[i + 1].startsWith('--')) {
      out[key] = args[++i];
    } else {
      out[key] = '';
    }
  }
  return out;
}

// Insert or update key-value pairs inside the first YAML frontmatter block.
function updateFrontmatter(content, updates) {
  const lines = content.split('\n');
  let startIdx = -1;
  let endIdx = -1;
  for (let i = 0; i < lines.length; i++) {
    if (lines[i].trim() === '---') {
      if (startIdx === -1) startIdx = i;
      else { endIdx = i; break; }
    }
  }
  if (startIdx === -1 || endIdx === -1) return content;
  const fmLines = lines.slice(startIdx + 1, endIdx);
  for (const [key, value] of Object.entries(updates)) {
    const keyRe = new RegExp('^' + key.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ':\\s*');
    const idx = fmLines.findIndex(l => keyRe.test(l));
    if (idx !== -1) {
      fmLines[idx] = `${key}: ${value}`;
    } else {
      fmLines.push(`${key}: ${value}`);
    }
  }
  return [...lines.slice(0, startIdx + 1), ...fmLines, ...lines.slice(endIdx)].join('\n');
}

// ── Evolution loop ─────────────────────────────────────────────────────────
//
// `osengineer evolve` orchestrates the HITL self-improvement flow.
// Proposals live in <repo>/.osengineer/evolution-proposals/<id>.md.
// Accepted patterns are promoted into <osEngineer-skill>/memory/patterns/.
// Rejections are logged to <repo>/.osengineer/evolution-rejections.jsonl.

function readEvolutionCounter(repoRoot) {
  const p = path.join(repoRoot, '.osengineer', 'evolution-counter.yml');
  if (!fs.existsSync(p)) return { phases_since_last_evolution: 0, total_evolutions_accepted: 0 };
  const raw = fs.readFileSync(p, 'utf8');
  const out = { phases_since_last_evolution: 0, total_evolutions_accepted: 0 };
  const m1 = raw.match(/^phases_since_last_evolution:\s*(\d+)/m);
  const m2 = raw.match(/^total_evolutions_accepted:\s*(\d+)/m);
  if (m1) out.phases_since_last_evolution = parseInt(m1[1], 10);
  if (m2) out.total_evolutions_accepted = parseInt(m2[1], 10);
  return out;
}

function writeEvolutionCounter(repoRoot, fields) {
  const p = path.join(repoRoot, '.osengineer', 'evolution-counter.yml');
  fs.mkdirSync(path.dirname(p), { recursive: true });
  const existing = readEvolutionCounter(repoRoot);
  const merged = { ...existing, ...fields };
  const lines = [
    '# Incremented by osEngineer-post-commit hook. Auto-nudge fires at >= 5.',
    `phases_since_last_evolution: ${merged.phases_since_last_evolution}`,
    `total_evolutions_accepted: ${merged.total_evolutions_accepted}`,
  ];
  if (merged.last_evolution_date) lines.push(`last_evolution_date: ${merged.last_evolution_date}`);
  fs.writeFileSync(p, lines.join('\n') + '\n');
}

function listProposals(repoRoot) {
  const dir = path.join(repoRoot, '.osengineer', 'evolution-proposals');
  if (!fs.existsSync(dir)) return [];
  return listDirSafe(dir).filter(f => /^EP-\d+-/.test(f) && f.endsWith('.md'));
}

function cmdEvolve(args) {
  const repoRoot = findRepoRoot(process.cwd());
  if (!repoRoot) { console.error('osengineer: not inside a git repo'); process.exit(1); }
  const sub = args[0];

  if (!sub || sub === 'status') {
    const c = readEvolutionCounter(repoRoot);
    const proposals = listProposals(repoRoot);
    const open = [];
    const closed = [];
    for (const f of proposals) {
      const content = fs.readFileSync(path.join(repoRoot, '.osengineer', 'evolution-proposals', f), 'utf8');
      (content.match(/^status:\s*(accepted|rejected)/im) ? closed : open).push(f);
    }
    process.stdout.write(`phases_since_last_evolution: ${c.phases_since_last_evolution}\n`);
    process.stdout.write(`total_evolutions_accepted: ${c.total_evolutions_accepted}\n`);
    if (c.phases_since_last_evolution >= 5) {
      process.stdout.write(`⚙ counter ≥ 5 — consider proposing improvements\n`);
    }
    process.stdout.write(`open proposals: ${open.length}\n`);
    for (const f of open) process.stdout.write(`  ○ ${f}\n`);
    process.stdout.write(`closed proposals: ${closed.length}\n`);
    for (const f of closed) process.stdout.write(`  ● ${f}\n`);
    return;
  }

  if (sub === 'propose') {
    const flags = parseFlags(args.slice(1), ['title', 'body-file', 'body', 'category']);
    if (!flags.title) {
      console.error('Usage: osengineer evolve propose --title "<t>" [--body "<text>" | --body-file <f>] [--category <c>]');
      process.exit(1);
    }
    const dir = path.join(repoRoot, '.osengineer', 'evolution-proposals');
    fs.mkdirSync(dir, { recursive: true });
    const existing = listProposals(repoRoot);
    let nextNum = 1;
    for (const f of existing) {
      const m = f.match(/^EP-(\d+)-/);
      if (m) nextNum = Math.max(nextNum, parseInt(m[1], 10) + 1);
    }
    const id = `EP-${String(nextNum).padStart(3, '0')}`;
    const slug = flags.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '').slice(0, 50);
    const file = path.join(dir, `${id}-${slug}.md`);
    let body = flags.body || '';
    if (flags['body-file']) {
      try { body = fs.readFileSync(flags['body-file'], 'utf8'); }
      catch { console.error(`osengineer: cannot read --body-file ${flags['body-file']}`); process.exit(1); }
    }
    const content = [
      '---',
      `proposal_id: ${id}`,
      `title: "${flags.title.replace(/"/g, '\\"')}"`,
      `category: ${flags.category || 'general'}`,
      'status: open',
      `opened_at: ${new Date().toISOString()}`,
      `opened_in_repo: ${path.basename(repoRoot)}`,
      '---',
      '',
      `# Evolution proposal ${id}: ${flags.title}`,
      '',
      body || '(no body provided — fill this in before requesting acceptance)',
      '',
    ].join('\n');
    fs.writeFileSync(file, content);
    process.stdout.write(`opened ${id} → ${path.relative(repoRoot, file)}\n`);
    return;
  }

  if (sub === 'accept') {
    const id = args[1];
    if (!id) { console.error('Usage: osengineer evolve accept <id> --pattern-slug <slug> [--pattern-file <f>]'); process.exit(1); }
    const flags = parseFlags(args.slice(2), ['pattern-slug', 'pattern-file']);
    if (!flags['pattern-slug']) { console.error('--pattern-slug is required'); process.exit(1); }
    const dir = path.join(repoRoot, '.osengineer', 'evolution-proposals');
    const files = listDirSafe(dir).filter(f => f.startsWith(`${id}-`) && f.endsWith('.md'));
    if (files.length === 0) { console.error(`osengineer: no proposal matching ${id}`); process.exit(1); }
    if (files.length > 1) { console.error(`osengineer: multiple proposals match ${id}`); process.exit(1); }
    const file = path.join(dir, files[0]);

    // Mark proposal accepted
    const original = fs.readFileSync(file, 'utf8');
    const updated = updateFrontmatter(original, {
      status: 'accepted',
      accepted_at: new Date().toISOString(),
    });
    fs.writeFileSync(file, updated);

    // Promote a pattern file into the osEngineer skill repo
    const patternFile = path.join(SCRIPT_DIR, 'memory', 'patterns', `${flags['pattern-slug']}.md`);
    if (flags['pattern-file']) {
      try {
        const src = fs.readFileSync(flags['pattern-file'], 'utf8');
        fs.mkdirSync(path.dirname(patternFile), { recursive: true });
        fs.writeFileSync(patternFile, src);
      } catch { console.error(`osengineer: cannot read --pattern-file ${flags['pattern-file']}`); process.exit(1); }
    } else {
      // Derive a minimal pattern stub from the proposal body
      const stub = [
        `# Pattern: ${flags['pattern-slug']}`,
        '',
        `Promoted from evolution proposal ${id} in repo ${path.basename(repoRoot)} on ${new Date().toISOString().slice(0,10)}.`,
        '',
        original.replace(/^---\n[\s\S]*?\n---\n/m, ''),
      ].join('\n');
      fs.mkdirSync(path.dirname(patternFile), { recursive: true });
      fs.writeFileSync(patternFile, stub);
    }

    // Reset counter and bump accepted total
    const c = readEvolutionCounter(repoRoot);
    writeEvolutionCounter(repoRoot, {
      phases_since_last_evolution: 0,
      total_evolutions_accepted: c.total_evolutions_accepted + 1,
      last_evolution_date: new Date().toISOString().slice(0, 10),
    });
    process.stdout.write(`accepted ${id} → memory/patterns/${flags['pattern-slug']}.md\ncounter reset to 0; total accepted = ${c.total_evolutions_accepted + 1}\n`);
    return;
  }

  if (sub === 'reject') {
    const id = args[1];
    if (!id) { console.error('Usage: osengineer evolve reject <id> --reason "<text>"'); process.exit(1); }
    const flags = parseFlags(args.slice(2), ['reason']);
    if (!flags.reason) { console.error('--reason is required'); process.exit(1); }
    const dir = path.join(repoRoot, '.osengineer', 'evolution-proposals');
    const files = listDirSafe(dir).filter(f => f.startsWith(`${id}-`) && f.endsWith('.md'));
    if (files.length === 0) { console.error(`osengineer: no proposal matching ${id}`); process.exit(1); }
    const file = path.join(dir, files[0]);
    const original = fs.readFileSync(file, 'utf8');
    const updated = original.replace(/^status:\s*open/m, 'status: rejected')
      .replace(/^(---\n[\s\S]*?)(\n---)/m, `$1\nrejected_at: ${new Date().toISOString()}\nreject_reason: "${flags.reason.replace(/"/g, '\\"')}"$2`);
    fs.writeFileSync(file, updated);

    // Append to rejections log
    const logPath = path.join(repoRoot, '.osengineer', 'evolution-rejections.jsonl');
    const entry = JSON.stringify({
      proposal_id: id, rejected_at: new Date().toISOString(), reason: flags.reason,
    }) + '\n';
    fs.appendFileSync(logPath, entry);

    // Reset counter (rejection counts toward "addressed")
    const c = readEvolutionCounter(repoRoot);
    writeEvolutionCounter(repoRoot, {
      phases_since_last_evolution: 0,
      total_evolutions_accepted: c.total_evolutions_accepted,
      last_evolution_date: new Date().toISOString().slice(0, 10),
    });
    process.stdout.write(`rejected ${id} (reason logged); counter reset to 0\n`);
    return;
  }

  console.error('Usage: osengineer evolve (status|propose|accept|reject) ...');
  process.exit(1);
}

function cmdExplain(args) {
  const topic = args[0] || 'overview';
  const messages = {
    overview:
      'osEngineer — a real-enforcement, multi-repo engineering skill.\n' +
      'Three-level nesting: workbench → repo → team. Each level has an\n' +
      'AGENTS.md (architect) and a .osengineer/ (state). Runtime enforcement\n' +
      'via git hooks + Claude hooks + this CLI + CI status checks.\n',
    phases:
      'Phase lifecycle: idle → discuss → plan → execute → verify → accepted.\n' +
      '`blocked` is a side-state entered on budget overrun or hard-rule violation.\n' +
      'Transitions are gated by hooks: no execute without PHASE_PLAN.md, no\n' +
      'verify without green test run, no merge without VERIFICATION.md.\n',
    hooks:
      'Ten enforcement hooks live in hooks/osEngineer-*. install.sh copies\n' +
      'the git hooks into .git/hooks/ and wires the Claude hooks via\n' +
      'absolute path in .claude/settings.json. Bypass any hook with\n' +
      'OSE_BYPASS=1 (logged to .osengineer/bypass-log.jsonl).\n',
    teams:
      'Five teams per repo: coding / testing / infra / docs / security.\n' +
      'install.sh auto-detects folder ownership from go.mod, ansible/,\n' +
      '*_test.go, docs/, .github/codeql etc., and writes both the YAML\n' +
      'in AGENTS.md AND a JSON cache in .osengineer/teams/<team>.json that\n' +
      'osEngineer-pre-edit-guard reads to enforce owns_paths at edit time.\n' +
      'Cross-team handoffs live in .osengineer/handoffs/HO-<n>-*.md and\n' +
      'are managed via `osengineer handoff (open|close|list)`.\n',
    handoffs:
      'Handoffs are filesystem-tracked tickets between teams. When team A\n' +
      'needs team B to act first, A runs:\n' +
      '  osengineer handoff open --from <A> --to <B> --slug <s> --closes-when "<text>"\n' +
      'and the architect agent watches the directory. Verify-phase transitions\n' +
      'are blocked while any handoff is open.\n',
    evolution:
      'Evolution loop: the post-commit hook increments\n' +
      '.osengineer/evolution-counter.yml; at >= 5 the session-start banner\n' +
      'auto-nudges. Propose an improvement with\n' +
      '  osengineer evolve propose --title "<t>" --body "<text>"\n' +
      'Accept with `osengineer evolve accept <id> --pattern-slug <s>` (promotes\n' +
      'to memory/patterns/) or `osengineer evolve reject <id> --reason "<r>"`\n' +
      '(logged to evolution-rejections.jsonl). Either action resets the counter.\n',
  };
  const msg = messages[topic];
  if (!msg) {
    process.stdout.write(`Unknown topic "${topic}". Available: ${Object.keys(messages).join(', ')}\n`);
    process.exit(1);
  }
  process.stdout.write(msg);
}

function usage() {
  process.stdout.write(
    `osengineer ${VERSION}\n\n` +
    'Usage:\n' +
    '  osengineer init <path>                  Initialise a repo with osEngineer wiring\n' +
    '  osengineer state                        Show .osengineer/state.yml fields\n' +
    '  osengineer state set <k> <v>            Update a state.yml field\n' +
    '  osengineer detect-teams <path>          Auto-detect team→folder mapping (outputs YAML)\n' +
    '  osengineer handoff open --from <t> --to <t> --slug <s> [--closes-when "<text>"]\n' +
    '  osengineer handoff close <id> [--reason "<text>"]\n' +
    '  osengineer handoff list\n' +
    '  osengineer discover-adrs <meta-path> [--out <file>]\n' +
    '                                          Scan a META repo for ADRs; emit YAML catalog\n' +
    '  osengineer evolve [status]              Show counter + open/closed proposals\n' +
    '  osengineer evolve propose --title "<t>" [--body "<text>" | --body-file <f>] [--category <c>]\n' +
    '  osengineer evolve accept <id> --pattern-slug <s> [--pattern-file <f>]\n' +
    '                                          Promote proposal to memory/patterns/<s>.md; reset counter\n' +
    '  osengineer evolve reject <id> --reason "<text>"\n' +
    '                                          Log rejection; reset counter\n' +
    '  osengineer version                      Print osEngineer version\n' +
    '  osengineer explain [topic]              overview|phases|hooks|teams|handoffs\n'
  );
}

// ── Dispatch ───────────────────────────────────────────────────────────────

const [, , sub, ...rest] = process.argv;
switch (sub) {
  case 'version':
  case '--version':
  case '-v':
    cmdVersion(); break;
  case 'init':
    cmdInit(rest); break;
  case 'state':
    cmdState(rest); break;
  case 'detect-teams':
    cmdDetectTeams(rest); break;
  case 'handoff':
    cmdHandoff(rest); break;
  case 'discover-adrs':
    cmdDiscoverAdrs(rest); break;
  case 'evolve':
    cmdEvolve(rest); break;
  case 'explain':
    cmdExplain(rest); break;
  case undefined:
  case 'help':
  case '--help':
  case '-h':
    usage(); break;
  default:
    process.stderr.write(`osengineer: unknown subcommand "${sub}"\n\n`);
    usage();
    process.exit(1);
}
