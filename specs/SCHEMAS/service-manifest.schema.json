{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://osengineer.dev/schemas/service-manifest.schema.json",
  "title": "osEngineer service manifest",
  "description": "Per-service YAML manifest validated at commit time. Source of truth for AMQP topology declarations, metrics endpoints, TLS requirements, and ADR references. Adapted to Observer Shield's AMQP-only inter-service rule.",
  "type": "object",
  "required": ["service", "owner_team", "amqp"],
  "properties": {
    "service": {
      "type": "object",
      "required": ["name", "language", "repo"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "language": { "type": "string", "enum": ["go", "python", "rust", "node", "ansible"] },
        "repo": { "type": "string" },
        "binary": { "type": "string" },
        "container_image": { "type": "string" }
      }
    },
    "owner_team": { "type": "string", "enum": ["coding", "testing", "infra", "docs", "security"] },
    "adr_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^ADR-\\d{3}$" }
    },
    "amqp": {
      "type": "object",
      "required": ["vhost"],
      "properties": {
        "vhost": { "type": "string" },
        "exchanges_produced": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type"],
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string", "enum": ["direct", "topic", "fanout", "headers"] },
              "durable": { "type": "boolean" },
              "routing_keys": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "queues_consumed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "exchange", "routing_key"],
            "properties": {
              "name": { "type": "string" },
              "exchange": { "type": "string" },
              "routing_key": { "type": "string" },
              "durable": { "type": "boolean" },
              "dlx": { "type": "string" }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "endpoint": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "scrape_interval_seconds": { "type": "integer", "minimum": 5 }
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "required": { "type": "boolean" },
        "ca_file_env": { "type": "string" },
        "cert_file_env": { "type": "string" },
        "key_file_env": { "type": "string" }
      }
    },
    "vault_secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "purpose"],
        "properties": {
          "path": { "type": "string" },
          "purpose": { "type": "string" }
        }
      }
    },
    "http": {
      "description": "DISALLOWED in Observer Shield except for /metrics and /healthz. Service-to-service communication is AMQP-only.",
      "type": "object",
      "properties": {
        "metrics_only": { "type": "boolean", "const": true }
      }
    }
  }
}
